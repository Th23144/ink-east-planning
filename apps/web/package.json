{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "seed": "pnpm run seed:editorial && pnpm run seed:commerce",
    "seed:editorial": "tsx src/payload/seed/seedInitialContent.ts",
    "seed:commerce": "tsx src/payload/seed/seedCommerce.ts",
    "check:public-reads": "tsx src/lib/public/checkPublicReads.ts",
    "check:commerce-contract": "tsx src/lib/commerce/checkCommerceContracts.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.84.1",
    "@payloadcms/next": "3.84.1",
    "next": "latest",
    "payload": "3.84.1",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest",
    "tsx": "latest"
  },
  "type": "module",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
